#!/usr/bin/env bash
# fs-lint-legibility managed hook

set -euo pipefail

if [[ "${FS_LINT_SKIP_HOOKS:-0}" == "1" ]]; then
  exit 0
fi

FS_LINT_REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly FS_LINT_REPO_ROOT
FS_LINT_CHANGED_FILES="$(
  git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || true
)"
readonly FS_LINT_CHANGED_FILES

case "$FS_LINT_CHANGED_FILES" in
  *scripts/setup.sh* | *scripts/hooks/*)
    "$FS_LINT_REPO_ROOT/scripts/setup.sh"
    ;;
esac
