#!/usr/bin/env bash
# fs-lint-legibility managed hook

set -euo pipefail

if [[ "${FS_LINT_SKIP_HOOKS:-0}" == "1" ]]; then
  printf 'pre-push: skipped by FS_LINT_SKIP_HOOKS\n'
  exit 0
fi

FS_LINT_REPO_ROOT="$(git rev-parse --show-toplevel)"
readonly FS_LINT_REPO_ROOT

run_suite() {
  local fs_lint_name="$1"
  local fs_lint_build_type="$2"
  local fs_lint_build_dir="$FS_LINT_REPO_ROOT/build-hooks-$fs_lint_name"
  shift 2
  cmake -S "$FS_LINT_REPO_ROOT" -B "$fs_lint_build_dir" \
    -DCMAKE_BUILD_TYPE="$fs_lint_build_type" "$@"
  cmake --build "$fs_lint_build_dir" --parallel
  ctest --test-dir "$fs_lint_build_dir" --output-on-failure
}

run_sanitizers() {
  local fs_lint_build_dir="$FS_LINT_REPO_ROOT/build-hooks-sanitized"
  local fs_lint_compile_flags="-Werror -fsanitize=address,undefined -fno-omit-frame-pointer"
  local fs_lint_linker_flags="-fsanitize=address,undefined"
  cmake -S "$FS_LINT_REPO_ROOT" -B "$fs_lint_build_dir" \
    -DCMAKE_BUILD_TYPE=Debug \
    "-DCMAKE_C_FLAGS=$fs_lint_compile_flags" \
    "-DCMAKE_EXE_LINKER_FLAGS=$fs_lint_linker_flags"
  cmake --build "$fs_lint_build_dir" --parallel
  run_sanitizer_tests "$fs_lint_build_dir"
}

run_sanitizer_tests() {
  local fs_lint_build_dir="$1"
  local fs_lint_asan_options="strict_string_checks=1"
  if [[ "$(uname -s)" == "Linux" ]]; then
    fs_lint_asan_options="detect_leaks=1:$fs_lint_asan_options"
  fi
  ASAN_OPTIONS="$fs_lint_asan_options" \
    UBSAN_OPTIONS=halt_on_error=1:print_stacktrace=1 \
    ctest --test-dir "$fs_lint_build_dir" --output-on-failure \
    --exclude-regex '^e2e-install$'
}

cd "$FS_LINT_REPO_ROOT"
run_suite release Release -DCMAKE_C_FLAGS=-Werror
run_sanitizers
